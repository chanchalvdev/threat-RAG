server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Serve React SPA — all unknown paths serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API and SSE streams to the backend. BACKEND_URL is filled in when the container starts
    # (nginx image templating): http://backend:8000 in compose, the API's https URL when hosted apart.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;                 # SNI for an https backend
        proxy_set_header Host $proxy_host;        # hosted backends route by their own host name
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;   # per-visitor rate limits
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for SSE (no buffering)
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 600s;  # investigations stream for minutes; the default 60 s cuts them off
        proxy_cache off;
        chunked_transfer_encoding on;
    }

    # Proxy health endpoint
    location /health {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
}
