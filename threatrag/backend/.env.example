# LLM: Gemini is primary. Kimchi is the fallback, and is skipped while its key is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
KIMCHI_API_KEY=
KIMCHI_BASE_URL=https://llm.kimchi.dev/openai/v1
LLM_MODEL=kimi-k2.7
# Evaluation judge: use a different model from the generator. Key/base URL default to the primary provider's.
JUDGE_MODEL=gemini-3.1-flash-lite
JUDGE_API_KEY=
JUDGE_BASE_URL=
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=4096
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=threat_intel_v2
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
DATABASE_URL=postgresql://threatrag:threatrag@localhost:5435/threatrag
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=6
# Retrieval: hybrid = dense + lexical fusion. EXACT_MATCH looks up T####/LLM## identifiers directly.
RETRIEVAL_MODE=hybrid
EXACT_MATCH=true
# cross_encoder lifts hit@6 from 0.95 to 0.98 but adds ~1.1 s per query on CPU (model downloads on first use)
RERANKER=none
MAX_CHUNKS_PER_REF=2
# Cosine thresholds calibrated on eval/golden.jsonl with nomic-embed-text; re-calibrate for another embedder
ABSTAIN_BELOW=0.57
CONFIDENT_ABOVE=0.68
DEBUG=true
LOG_FORMAT=console
TAVILY_API_KEY=
# Threat intel enrichment. Each source is skipped while its key is empty.
# Shodan InternetDB, CISA KEV and FIRST EPSS need no key.
ABUSEIPDB_API_KEY=
OTX_API_KEY=
ABUSECH_AUTH_KEY=
# Tracing: set both keys to send every LLM call to Langfuse. In-process telemetry (/api/v1/metrics) is always on.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# USD per million tokens for the primary model. Leave 0 and cost is reported as unknown rather than guessed.
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
# Prompt-injection guard: off | heuristic | llm (llm = one extra judge-model call per request that patterns let through)
GUARD_MODE=heuristic
# API surface
API_KEY=
# Identity: when JWT_SECRET is set, /api/v1/* requires `Authorization: Bearer <HS256 token>` and chat
# sessions belong to the token's `sub`. Mint a dev token: python -m app.scripts.mint_token --sub alice
JWT_SECRET=
# Requests per minute per identity (per client address when anonymous). 0 disables.
RATE_LIMIT_PER_MINUTE=120
# Public demo: total model-calling requests per UTC day across all callers (query, chat, investigate,
# evaluate, suggestions). Bounds spend on your key. 0 disables.
LLM_DAILY_REQUEST_CAP=0
# Shared state for chat history, ingest jobs and rate limits. Empty = in-process (single worker, lost on restart).
# docker compose exposes Redis on host port 6380.
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
MAX_UPLOAD_MB=25
